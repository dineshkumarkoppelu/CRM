# Copy to api/.env and edit. Real environment variables win over this file.

# Neo4j password - at least 8 characters. Must match the password set with neo4j-admin.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
# Bolt URI of the DEV Neo4j instance. Use 127.0.0.1 rather than localhost if Neo4j only listens
# on IPv4 (e.g. a Docker port bound to 127.0.0.1): on Windows `localhost` tries ::1 first and a
# refused connection there costs ~2 s.
NEO4J_URI=bolt://localhost:7687
# Fixed "today" as YYYY-MM-DD for deterministic seeds/demos. Empty = real current date.
AS_OF_DATE=
LOG_LEVEL=INFO
# Run the nightly recompute scheduler in this process (true/false).
SCHEDULER_ENABLED=true
# Bolt URI of the separate TEST Neo4j instance (Bolt port 7688). Tests WIPE it.
TEST_NEO4J_URI=bolt://localhost:7688

# ---- Live data source (Postgres API). Leave SOURCE_API_URL empty for standalone mode. ----
# The CRUD API in front of Postgres (locally http://127.0.0.1:8010, or the public ngrok URL).
SOURCE_API_URL=
# Its X-API-Key.
SOURCE_API_KEY=
# Direct Postgres connection, used only for LISTEN (real-time push). Postgres is published on
# 127.0.0.1:5433 by the "Host db" stack. Empty = no push: the API is polled every
# SYNC_POLL_SECONDS instead.
SOURCE_PG_DSN=
# SYNC_POLL_SECONDS=5
# SYNC_RECONCILE_SECONDS=300
# SYNC_RECOMPUTE_DEBOUNCE_SECONDS=3
